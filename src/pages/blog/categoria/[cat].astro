---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import PostCard from '../../../components/PostCard.astro';
import Cta from '../../../components/Cta.astro';
import { publishedPosts, slugify } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((c) => ({ params: { cat: slugify(c) }, props: { nome: c, posts: posts.filter((p) => p.data.category === c) } }));
}
const { nome, posts } = Astro.props;
---
<Base title={`${nome}: artigos de pediatria`} description={`Artigos da Dra. Camilla Arouca, pediatra, sobre ${nome.toLowerCase()}: orientações baseadas em evidências para famílias.`}>
  <PageHeader eyebrow={nome} title={`Artigos sobre ${nome.toLowerCase()}`} crumbs={[{ href: '/blog/', label: 'Blog' }]} />
  <section class="section">
    <div class="wrap grid grid-3">{posts.map((p) => <PostCard post={p} />)}</div>
  </section>
  <Cta />
</Base>
