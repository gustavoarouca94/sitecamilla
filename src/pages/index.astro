---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Cta from '../components/Cta.astro';
import FaixaSabado from '../components/FaixaSabado.astro';
import Duvidas from '../components/Duvidas.astro';
import { site, consultas, whatsappLink } from '../data/site';
import { duvidasDestaque, faqSchema } from '../data/duvidas';
import retrato from '../assets/camilla-retrato.jpg';
import consultorio from '../assets/consultorio.jpg';
import parquinho from '../assets/parquinho.jpg';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<Base
  title="Pediatra particular perto de Boa Viagem · Dra. Camilla Arouca"
  description="Pediatria baseada em evidências, com tempo e acolhimento. Atendimento particular de segunda a sábado no The Garden, em Piedade, perto de Boa Viagem."
  schema={[faqSchema(duvidasDestaque)]}
>
  <!-- a. Topo -->
  <section class="hero">
    <div class="wrap split rev">
      <div class="hero-texto">
        <span class="eyebrow">Pediatra em Piedade · perto de Boa Viagem</span>
        <h1>Clareza nas <span class="brilho">escolhas.</span><br />Confiança no cuidado.</h1>
        <p class="lead">Pediatria baseada em evidências que conversa com a vida real. Eu transformo ciência em orientações compreensíveis, possíveis e individualizadas para cada criança e sua família.</p>
        <div class="acoes">
          <a class="btn btn-primary" href={whatsappLink()} target="_blank" rel="noopener">Agendar consulta pelo WhatsApp</a>
          <a class="btn btn-ghost" href="/consultas/">Conhecer as consultas</a>
        </div>
        <p class="apoio">{site.nome} · Pediatra · Piedade, Jaboatão dos Guararapes<br />{site.crm} · {site.rqe}</p>
      </div>
      <div class="hero-foto">
        <div class="arch"><Image src={retrato} alt="Dra. Camilla Arouca, pediatra, sorrindo em um jardim" widths={[400, 700, 1000]} sizes="(min-width: 860px) 460px, 90vw" loading="eager" fetchpriority="high" /></div>
      </div>
    </div>
  </section>

  <!-- b. Faixa segunda a sábado -->
  <FaixaSabado />

  <!-- c. Método AME -->
  <section class="section">
    <div class="wrap">
      <div class="center narrow">
        <span class="eyebrow">Como eu cuido</span>
        <h2>Método AME: Apoio às Melhores Escolhas possíveis.</h2>
        <p class="lead">Eu não acredito que meu papel seja oferecer todas as respostas. Acredito que seja fortalecer a família para fazer as melhores perguntas e, juntos, encontrarmos o melhor caminho para cada criança.</p>
        <p class="tres">Três ideias guiam cada consulta:</p>
      </div>
      <div class="grid grid-3 pilares">
        <div class="card"><span class="dot rosa"></span><h3>Família protagonista</h3><p>Quem conhece seu filho é você. Eu caminho ao lado, como apoio técnico.</p></div>
        <div class="card"><span class="dot dourado"></span><h3>Evidência com vida real</h3><p>A melhor ciência disponível, traduzida para a rotina possível da sua casa.</p></div>
        <div class="card"><span class="dot salvia"></span><h3>Escolhas possíveis</h3><p>Não existe família perfeita. Existe a melhor escolha para o seu momento.</p></div>
      </div>
    </div>
  </section>

  <!-- d. As consultas -->
  <section class="section alt">
    <div class="wrap">
      <div class="center">
        <span class="eyebrow">Consultas</span>
        <h2>Cuidado em cada fase</h2>
      </div>
      <div class="grid grid-3" style="margin-top:2rem">
        {consultas.map((c) => (
          <a class="card servico" href={`/consultas/${c.slug}/`}>
            <span class={`dot ${c.cor}`}></span>
            <h3>{c.nome}</h3>
            <p>{c.resumo}</p>
            <span class="mais">Saiba mais →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- e. O que você leva -->
  <section class="section">
    <div class="wrap split">
      <div class="plano" aria-hidden="true">
        <div class="folha">
          <img src="/img/elefante.png" alt="" width="34" height="40" />
          <p class="folha-tit">Plano de cuidados</p>
          <span></span><span></span><span class="curta"></span>
          <p class="folha-sub">Próximos passos</p>
          <span></span><span class="curta"></span>
        </div>
      </div>
      <div>
        <span class="eyebrow">O que você leva da consulta</span>
        <h2>Você sai da consulta com um plano.</h2>
        <p>Ao final de cada atendimento, a família recebe um <strong>plano de cuidados individualizado</strong>, com as principais orientações e os próximos passos. Para ler com calma em casa e voltar a ele quando precisar.</p>
        <a class="btn btn-ghost" href="/como-funciona/">Como funciona a consulta</a>
      </div>
    </div>
  </section>

  <!-- f. O espaço -->
  <section class="section creme">
    <div class="wrap split rev">
      <div>
        <span class="eyebrow">O espaço</span>
        <h2>O cuidado não começa quando a porta do consultório se fecha.</h2>
        <p>Ele também está na forma como recebemos uma família. Por isso escolhi atender no <strong>The Garden</strong>, um espaço arborizado, com parquinho a céu aberto, estacionamento gratuito e perto de laboratórios, farmácias e clínicas. Dentro da clínica, recepção acolhedora, brinquedoteca, fraldário e banheiro.</p>
        <a class="btn btn-ghost" href="/como-funciona/#espaco">Conhecer o espaço</a>
      </div>
      <div class="fotos">
        <div class="arch f1"><Image src={consultorio} alt="Consultório pediátrico com mesa, poltronas e maca em tons claros" widths={[400, 700]} sizes="(min-width: 860px) 300px, 55vw" /></div>
        <div class="foto f2"><Image src={parquinho} alt="Parquinho com escorregador entre as árvores do The Garden" widths={[300, 500]} sizes="(min-width: 860px) 220px, 40vw" /></div>
      </div>
    </div>
  </section>

  <!-- g. Perguntas frequentes -->
  <section class="section">
    <div class="narrow">
      <div class="center">
        <span class="eyebrow">Dúvidas frequentes</span>
        <h2>As perguntas que as famílias mais fazem</h2>
      </div>
      <Duvidas itens={duvidasDestaque} />
      <p class="center" style="margin-top:1.6rem"><a class="btn btn-ghost" href="/duvidas/">Ver todas as dúvidas</a></p>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section alt">
      <div class="wrap">
        <div class="center"><span class="eyebrow">Blog</span><h2>Informação de qualidade, em linguagem simples</h2></div>
        <div class="grid grid-3" style="margin-top:2rem">{posts.map((p) => <PostCard post={p} />)}</div>
        <p class="center" style="margin-top:2rem"><a class="btn btn-ghost" href="/blog/">Ver todos os artigos</a></p>
      </div>
    </section>
  )}

  <!-- h. Chamada final -->
  <Cta />
</Base>

<style>
  .hero { padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(3rem, 7vw, 5.5rem); }
  .hero h1 { margin-bottom: 0.55em; }
  .acoes { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 1.8rem 0 1.3rem; }
  .apoio { font-size: 0.86rem; color: var(--texto-suave); line-height: 1.6; }
  .hero-foto { max-width: 460px; margin-inline: auto; width: 100%; padding: 10px; }
  .hero-foto .arch { aspect-ratio: 4 / 4.5; box-shadow: var(--sombra); }
  .tres { font-family: var(--titulo); color: var(--salvia-escura); margin-top: 1.4rem; }
  .pilares { margin-top: 1.4rem; }
  .pilares p { margin: 0; color: var(--texto-suave); }
  .servico { text-decoration: none; color: inherit; display: block; transition: transform 0.2s ease; }
  .servico:hover { transform: translateY(-4px); }
  .servico p { color: var(--texto-suave); }
  .servico .mais { font-family: var(--titulo); font-size: 0.85rem; color: var(--dourado-texto); }
  .plano { display: grid; place-items: center; padding: 1rem; }
  .folha { width: min(320px, 100%); aspect-ratio: 3 / 3.6; background: var(--branco); border: 1px solid var(--linha); border-radius: 18px;
    box-shadow: var(--sombra); padding: 1.8rem 1.6rem; display: flex; flex-direction: column; gap: 0.7rem; transform: rotate(-2.5deg);
    outline: 1px solid var(--dourado); outline-offset: 8px; }
  .folha img { width: 30px; }
  .folha-tit { font-family: var(--script); color: var(--dourado-texto); font-size: 1.6rem; margin: 0; }
  .folha-sub { font-family: var(--titulo); font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--salvia-escura); margin: 0.6rem 0 0; }
  .folha span { display: block; height: 8px; border-radius: 4px; background: var(--creme-claro); }
  .folha span.curta { width: 60%; }
  .fotos { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1rem; align-items: end; padding: 10px; }
  .fotos .f1 { aspect-ratio: 3 / 4.6; }
  .fotos .f2 { aspect-ratio: 3 / 3.8; margin-bottom: 2rem; }
</style>
