---
// Banner de cookies (LGPD) + Google Analytics 4 / Google Ads + registro de cliques de contato.
// Modo "básico": nenhum script do Google é carregado antes de a pessoa aceitar.
// Os códigos ficam em src/data/site.ts → medicao. Sem códigos, nada é exibido nem carregado.
import { site } from '../data/site';
const m = site.medicao;
const tags = [m.ga4, m.googleAds].filter(Boolean);
const config = {
  tags,
  conversoes: { whatsapp: m.conversaoWhatsapp, doctoralia: m.conversaoDoctoralia, telefone: m.conversaoTelefone },
};
---
{tags.length > 0 && (
  <>
    <div id="cookie-banner" class="cookie" role="dialog" aria-live="polite" aria-label="Aviso de cookies" hidden>
      <p>
        Usamos cookies para medir as visitas e entender como as famílias chegam até aqui. Você pode aceitar ou recusar.{' '}
        <a href="/privacidade/#cookies">Saiba mais</a>.
      </p>
      <div class="acoes">
        <button type="button" class="btn btn-ghost" data-consent="denied">Recusar</button>
        <button type="button" class="btn btn-primary" data-consent="granted">Aceitar</button>
      </div>
    </div>

    <script is:inline define:vars={{ config }}>
      (function () {
        var KEY = 'consentimento-cookies';
        var carregado = false;
        var banner = document.getElementById('cookie-banner');

        function ler() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
        function gravar(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }

        function carregarGoogle() {
          if (carregado || !config.tags.length) return;
          carregado = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          gtag('consent', 'default', {
            analytics_storage: 'granted',
            ad_storage: 'granted',
            ad_user_data: 'granted',
            // Saúde é categoria sensível: sem personalização de anúncios nem remarketing.
            ad_personalization: 'denied',
          });
          gtag('js', new Date());
          config.tags.forEach(function (id) { gtag('config', id, { allow_google_signals: false }); });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(config.tags[0]);
          document.head.appendChild(s);
        }

        function mostrar() { if (banner) banner.hidden = false; }
        function esconder() { if (banner) banner.hidden = true; }

        var escolha = ler();
        if (escolha === 'granted') carregarGoogle();
        else if (escolha !== 'denied') mostrar();

        document.addEventListener('click', function (ev) {
          var botao = ev.target.closest && ev.target.closest('[data-consent]');
          if (botao) {
            var v = botao.getAttribute('data-consent');
            gravar(v);
            esconder();
            if (v === 'granted') carregarGoogle();
            return;
          }
          if (ev.target.closest && ev.target.closest('[data-cookie-prefs]')) {
            ev.preventDefault();
            mostrar();
            return;
          }
          // Registro de cliques de contato (só depois do consentimento).
          var a = ev.target.closest && ev.target.closest('a[href]');
          if (!a || !carregado || !window.gtag) return;
          var href = a.getAttribute('href') || '';
          var tipo = /wa\.me|whatsapp\.com/.test(href) ? 'whatsapp'
            : /doctoralia\./.test(href) ? 'doctoralia'
            : /^tel:/.test(href) ? 'telefone'
            : null;
          if (!tipo) return;
          gtag('event', 'contato_' + tipo, {
            pagina: location.pathname,
            local_do_botao: a.className || a.textContent.trim().slice(0, 40),
            transport_type: 'beacon',
          });
          var conv = config.conversoes[tipo];
          if (conv) gtag('event', 'conversion', { send_to: conv, transport_type: 'beacon' });
        });
      })();
    </script>
  </>
)}

<style>
  .cookie {
    position: fixed; left: 1rem; right: 1rem; bottom: 1rem; z-index: 80; max-width: 560px; margin-left: auto;
    background: var(--branco); border: 1px solid var(--linha); border-radius: 18px; padding: 1.1rem 1.25rem;
    box-shadow: 0 18px 40px -18px rgba(60, 45, 35, 0.45);
  }
  .cookie[hidden] { display: none; }
  .cookie p { font-size: 0.92rem; margin: 0 0 0.9rem; }
  .acoes { display: flex; gap: 0.6rem; justify-content: flex-end; flex-wrap: wrap; }
  .acoes .btn { padding: 0.6rem 1.2rem; font-size: 0.88rem; }
</style>
