<style>
  .wpp { position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 60; display: flex; align-items: center; gap: 0.5rem;
    background: var(--salvia-escura); color: #fff; text-decoration: none; padding: 0.8rem 1.1rem; border-radius: 999px;
    font-family: var(--titulo); font-weight: 600; font-size: 0.9rem; box-shadow: 0 10px 30px -10px rgba(60, 60, 40, 0.6); }
  .wpp svg { width: 22px; height: 22px; }
  .wpp:hover { background: #5d6349; }
  @media (max-width: 520px) { .wpp span { display: none; } .wpp { padding: 0.85rem; } }
</style>
