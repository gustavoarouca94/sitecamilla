---
interface Props { eyebrow: string; title: string; lead?: string; crumbs?: { href: string; label: string }[] }
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
import { site } from '../data/site';
const all = [{ href: '/', label: 'Início' }, ...crumbs];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [...all, { href: Astro.url.pathname, label: title }].map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.label, item: new URL(c.href, site.url).href,
  })),
};
---
<section class="ph">
  <div class="narrow center">
    <nav class="migalhas" aria-label="Você está em">
      {all.map((c) => <><a href={c.href}>{c.label}</a><span aria-hidden="true"> / </span></>)}
      <span aria-current="page">{eyebrow}</span>
    </nav>
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
<style>
  .ph { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem); background: var(--areia-2); }
  .migalhas { font-size: 0.8rem; color: var(--texto-suave); margin-bottom: 1.6rem; }
  .migalhas a { text-decoration: none; color: var(--texto-suave); }
  .migalhas a:hover { color: var(--cafe); }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); }
</style>
