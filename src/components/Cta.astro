---
import { whatsappLink } from '../data/site';
interface Props { titulo?: string; texto?: string; botao?: string }
const {
  titulo = 'Se essa forma de enxergar a Pediatria faz sentido para você, seja bem-vinda.',
  texto,
  botao = 'Conversar pelo WhatsApp',
} = Astro.props;
---
<section class="cta">
  <div class="narrow center">
    <img src="/img/elefante.png" alt="" width="64" height="75" loading="lazy" />
    <h2>{titulo}</h2>
    {texto && <p class="lead">{texto}</p>}
    <a class="btn btn-primary" href={whatsappLink()} target="_blank" rel="noopener">{botao}</a>
  </div>
</section>
<style>
  .cta { background: var(--creme-claro); padding: clamp(3.5rem, 8vw, 5.5rem) 0; }
  .cta img { width: 60px; margin: 0 auto 1.2rem; }
  .cta h2 { max-width: 640px; margin-inline: auto; margin-bottom: 1.4rem; }
  .cta .lead { margin-bottom: 1.6rem; }
</style>
